{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "sd-xl",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true,

  "ai": {
    "binding": "AI"
  }
}