{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sd-xl",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "imagination"
    }
  ]
}
